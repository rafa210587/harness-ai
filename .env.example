# LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Runtime
HARNESS_DATA_DIR=./data
HARNESS_WORKSPACE=./workspace
HARNESS_LOG_LEVEL=INFO
AGENT_LLM_TIMEOUT_SECONDS=120
AGENT_LLM_MAX_ATTEMPTS=3
AGENT_LLM_RETRY_BASE_SECONDS=1.0

# Browser
HARNESS_BROWSER_PROFILE=./data/browser-profile
HARNESS_BROWSER_HEADLESS=false
HARNESS_BROWSER_CHANNEL=chrome

# Applications
BLENDER_PATH=
UNITY_PATH=

# Optional disposable project used only by `pytest -m unity`
HARNESS_UNITY_SMOKE_PROJECT=
