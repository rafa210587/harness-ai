{
  "$schema": "https://opencode.ai/config.json",

  // Migration baseline: keep runtime upgrades explicit and testable.
  "autoupdate": false,
  "share": "disabled",

  // Conservative migration defaults. Relax only after parity/security gates.
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "external_directory": "deny",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git push*": "ask",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny",
      "Remove-Item -Recurse*": "deny"
    }
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.81",
        "--browser=chrome"
      ],
      "enabled": true,
      "timeout": 15000
    }
  }
}
